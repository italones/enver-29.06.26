<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор" Height="400" Width="320"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- TextBox на все 4 столбца -->
        <TextBox x:Name="Display"
                 Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                 FontSize="28" TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 Margin="2" IsReadOnly="True" Text="0"/>

        <!-- Строка 1 -->
        <Button Content="7" Grid.Row="1" Grid.Column="0" Margin="2" FontSize="20" Click="Digit_Click"/>
        <Button Content="8" Grid.Row="1" Grid.Column="1" Margin="2" FontSize="20" Click="Digit_Click"/>
        <Button Content="9" Grid.Row="1" Grid.Column="2" Margin="2" FontSize="20" Click="Digit_Click"/>
        <Button Content="÷" Grid.Row="1" Grid.Column="3" Margin="2" FontSize="20" Click="Op_Click"/>

        <!-- Строка 2 -->
        <Button Content="4" Grid.Row="2" Grid.Column="0" Margin="2" FontSize="20" Click="Digit_Click"/>
        <Button Content="5" Grid.Row="2" Grid.Column="1" Margin="2" FontSize="20" Click="Digit_Click"/>
        <Button Content="6" Grid.Row="2" Grid.Column="2" Margin="2" FontSize="20" Click="Digit_Click"/>
        <Button Content="×" Grid.Row="2" Grid.Column="3" Margin="2" FontSize="20" Click="Op_Click"/>

        <!-- Строка 3 -->
        <Button Content="1" Grid.Row="3" Grid.Column="0" Margin="2" FontSize="20" Click="Digit_Click"/>
        <Button Content="2" Grid.Row="3" Grid.Column="1" Margin="2" FontSize="20" Click="Digit_Click"/>
        <Button Content="3" Grid.Row="3" Grid.Column="2" Margin="2" FontSize="20" Click="Digit_Click"/>
        <Button Content="−" Grid.Row="3" Grid.Column="3" Margin="2" FontSize="20" Click="Op_Click"/>

        <!-- Строка 4 -->
        <Button Content="0" Grid.Row="4" Grid.Column="0" Margin="2" FontSize="20" Click="Digit_Click"/>
        <Button Content="," Grid.Row="4" Grid.Column="1" Margin="2" FontSize="20" Click="Comma_Click"/>
        <Button Content="=" Grid.Row="4" Grid.Column="2" Margin="2" FontSize="20" Click="Equals_Click"/>
        <Button Content="+" Grid.Row="4" Grid.Column="3" Margin="2" FontSize="20" Click="Op_Click"/>
    </Grid>
</Window>